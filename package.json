{
  "name": "hpfc-summer-party-app-2026",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:migrate:local && next dev",
    "dev:migrate": "npm run db:migrate:local && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "vitest run",
    "db:migrate": "npm run db:migrate:local",
    "db:migrate:local": "supabase db push --local",
    "db:migrate:remote": "supabase db push --db-url \"$SUPABASE_DB_URL\" --password \"$SUPABASE_DB_PASSWORD\"",
    "db:reset:local": "supabase db reset --local",
    "demo:seed": "node scripts/day-flow-smoke.mjs --seed-only",
    "smoke:e2e": "node scripts/day-flow-smoke.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.469.0",
    "next": "15.5.19",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "packageManager": "npm@11.6.2+sha512.ee22b335fcbc95662cdf3ab8a053daf045d9cf9c6df6040d28965abb707512b2c16fa6c5eec049d34c74f78f390cebd14f697919eadb97756564d4f9eccc4954"
}
