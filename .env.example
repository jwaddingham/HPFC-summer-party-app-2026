# Copy this file to .env.local for local development.
# Do not commit .env.local or real secrets.

# Shared admin code used by POST /api/admin/login.
# Choose a long, event-specific value for deployed environments.
ADMIN_ACCESS_CODE=change-me

# Public Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase anon key. Safe to expose to the browser when RLS is enabled.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase service role key for admin API routes and migrations.
# Never expose this in client components or NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase CLI database connection values for local/CI migration commands.
# Local development can use the values produced by `supabase start`.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_PASSWORD=postgres
